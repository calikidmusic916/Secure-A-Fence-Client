<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRentalId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RNT-5012"
                android:textColor="@color/primary_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRentalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Agreement"
                android:textColor="@color/status_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvRentalAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Site: Downtown Tower (450 Main St)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvRentalDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Term: 2024-05-01 to 2024-11-01"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvMonthlyRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$145.00 / month"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

            <Button
                android:id="@+id/btnExtendRental"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extend Term"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/white"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
